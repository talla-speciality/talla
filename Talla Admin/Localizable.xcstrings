        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تُطبَّق التغييرات على الشحنة التالية التي لم تُجهَّز بعد. وإذا كانت قد جُهِّزت بالفعل، فتبدأ التغييرات من الشحنة التي تليها."
          }
        }
      }
    },
