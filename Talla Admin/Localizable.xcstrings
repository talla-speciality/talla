      }
    },
    "This executes the refund with Shopify and marks the order Cancelled. It does not create a refund request in the customer app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "يؤدي هذا إلى تنفيذ الاسترداد عبر Shopify ووضع علامة \"ملغى\" على الطلب. ولا ينشئ طلب استرداد في تطبيق العميل."
          }
        }
      }
    },
    "This removes the product from Shopify and cannot be undone." : {
