    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Privacy - Bluetooth Always Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتصل تله سبيشاليتي بموازين Acaia و BOOKOO و GOAT STORY GINA و HIROIA و MANTABREW المدعومة لعرض الوزن والتدفق مباشرة أثناء التحضير الموجَّه."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Talla Speciality connects to supported Acaia, BOOKOO, GOAT STORY GINA, HIROIA, and MANTABREW scales to show live weight and flow during guided brews."
          }
        }
      }
    },
    "NSCameraUsageDescription" : {
      "comment" : "Privacy - Camera Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تستخدم تله الكاميرا لمسح الرموز ودعم ميزات الطلب داخل التطبيق."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Talla uses the camera to scan codes and support in-app ordering features."
          }
        }
      }
    },
    "NSHealthUpdateUsageDescription" : {
      "comment" : "Privacy - Health Update Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تسجل تله تقديرات الكافيين من عمليات التحضير المكتملة في Apple Health لتتمكن من متابعة استهلاك الكافيين يوميًا."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Talla records estimated caffeine from your completed brews in Apple Health so you can track your daily caffeine intake."
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription" : {
      "comment" : "Privacy - Local Network Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتصل تله سبيشاليتي بخادم التطوير المحلي لاختبار ميزات الحساب والولاء والطلبات على هذا الجهاز."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Talla Speciality connects to your local development server so account, loyalty, and order features can be tested on this device."
          }
        }
      }
    },
    "NSPhotoLibraryUsageDescription" : {
      "comment" : "Privacy - Photo Library Usage Description",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "machine_translated",
            "value" : "تتيح لك تله سبيشاليتي اختيار صورة للقهوة أو لإعداد التحضير حتى يتمكن المرشد من اقتراح منتجات وإرشادات تحضير أفضل."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Talla Speciality lets you choose a coffee or setup photo so the concierge can suggest better products and brewing guidance."
          }
        }
      }
    }
  },
  "version" : "1.3"
}