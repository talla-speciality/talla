<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NFCReaderUsageDescription</key>
	<string>Scan Talla tags on coffee bags and brewing cards to open the matching product or guide.</string>
	<key>NSBluetoothAlwaysUsageDescription</key>
	<string>Talla Speciality connects to supported Acaia, BOOKOO, GOAT STORY GINA, HIROIA, and MANTABREW scales to show live weight and flow during guided brews.</string>
	<key>BackendBaseURL</key>
	<string>https://talla-backend.onrender.com</string>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.talla.speciality</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>talla</string>
			</array>
		</dict>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>None</string>
			<key>CFBundleURLName</key>
			<string>com.talla.speciality.benefitpay</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>tallabenefitpay</string>
			</array>
		</dict>
	</array>
	<key>BenefitPaySDKSecretKey</key>
	<string>$(BENEFITPAY_SDK_SECRET_KEY)</string>
	<key>INIntentsSupported</key>
	<array>
		<string>Intent</string>
	</array>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>benefitinapp</string>
	</array>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsArbitraryLoads</key>
		<false/>
		<key>NSAllowsLocalNetworking</key>
		<true/>
		<key>NSExceptionDomains</key>
		<dict>
			<key>127.0.0.1</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
			<key>localhost</key>
			<dict>
				<key>NSExceptionAllowsInsecureHTTPLoads</key>
				<true/>
			</dict>
		</dict>
	</dict>
</dict>
</plist>
