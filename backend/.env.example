HOST=0.0.0.0
PORT=8787
NODE_ENV=production
APP_URL=https://api.tallaspeciality.com
CORS_ALLOWED_ORIGIN=*
DATA_DIRECTORY=./data

# Postgres
DATABASE_URL=
PGSSLMODE=

# Admin and customer sessions
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_APP_EMAILS=
ADMIN_SESSION_HOURS=12
CUSTOMER_TOKEN_SECRET=
CUSTOMER_TOKEN_HOURS=168

# Transactional email and account identity
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=
APPLE_SIGN_IN_CLIENT_ID=Talla-Speciality.Talla-Speciality

# App Attest production settings
APP_ATTEST_APP_ID=TAG9WXY85M.Talla-Speciality.Talla-Speciality
APP_ATTEST_ENFORCE=true
APP_ATTEST_ALLOW_DEVELOPMENT=false

# Apple Pay settlement and push notifications
APPLE_PAY_SETTLEMENT_PROVIDER=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_BUNDLE_ID=
APNS_USE_SANDBOX=false
APNS_PRIVATE_KEY_PATH=
APNS_PRIVATE_KEY_BASE64=

# Android FCM and Play Integrity (base64 of the Google service-account JSON)
GOOGLE_CLOUD_PROJECT_ID=
GOOGLE_SERVICE_ACCOUNT_JSON_BASE64=
PLAY_INTEGRITY_PACKAGE_NAME=com.talla.speciality
PLAY_INTEGRITY_ENFORCE=true

# Account security and operations
PASSWORD_RESET_TOKEN_HOURS=1
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=240
REQUEST_LOGGING_ENABLED=true
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_CHECK_INTERVAL_MS=300000
OPS_ALERT_WINDOW_MINUTES=15
OPS_ALERT_5XX_THRESHOLD=5
OPS_ALERT_429_THRESHOLD=20
OPS_ALERT_COOLDOWN_MINUTES=30

# Shopify Admin API and webhooks
SHOPIFY_ADMIN_SHOP_DOMAIN=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_ADMIN_API_VERSION=2025-10
SHOPIFY_ADMIN_PUBLICATION_ID=
SHOPIFY_WEBHOOK_SECRET=

# BENEFIT hosted-payment gateway
BENEFIT_TRANPORTAL_ID=
BENEFIT_TRANPORTAL_PASSWORD=
BENEFIT_RESOURCE_KEY=
BENEFIT_API_ENDPOINT=
BENEFIT_SUCCESS_URL=
BENEFIT_ERROR_URL=
BENEFIT_NOTIFICATION_URL=

# BenefitPay merchant QR and transaction-status API
BENEFITPAY_APP_ID=
BENEFITPAY_MERCHANT_ID=
BENEFITPAY_SECRET_KEY=
BENEFITPAY_CHECK_STATUS_URL=
BENEFITPAY_MERCHANT_NAME=
BENEFITPAY_MERCHANT_CITY=
BENEFITPAY_MCC=
BENEFITPAY_COUNTRY_CODE=BH

# Mastercard Payment Gateway Services (MPGS)
MPGS_MERCHANT_ID=
MPGS_API_PASSWORD=
MPGS_API_PASSWORD_SECONDARY=
MPGS_API_VERSION=100
MPGS_BASE_URL=https://eazypay.gateway.mastercard.com

# EazyPay hosted checkout
EAZY_APP_ID=
EAZY_SECRET_KEY=
EAZY_API_BASE_URL=https://api.eazy.net
EAZY_PAYMENT_METHODS=BENEFITGATEWAY,CREDITCARD,APPLEPAY

# Apple Wallet pass generation and update service
WALLET_PASS_TEMPLATE_DIRECTORY=../WalletPass/TallaLoyalty.pass
WALLET_P12_PATH=
WALLET_P12_BASE64=
WALLET_P12_PASSWORD=
WALLET_WWDR_PATH=
WALLET_WWDR_BASE64=
WALLET_WEB_SERVICE_URL=https://api.tallaspeciality.com/wallet
